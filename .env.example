# Variaveis de ambiente do By Imperio Dog.
#
# Este arquivo e VERSIONADO e o repositorio e publico: ele lista NOMES e
# instrucoes, nunca valores. Copie para `.env.local` (ignorado pelo git) e
# preencha la. Em producao quem le as variaveis e o painel da Netlify
# (Site configuration > Environment variables) — nao existe arquivo de env no
# deploy.
#
# Regra que vale para o arquivo inteiro: variavel com prefixo NEXT_PUBLIC_ e
# inlinada no bundle do navegador e fica visivel para qualquer visitante.
# Segredo nenhum pode usar esse prefixo. As demais so existem no servidor.
#
# Este arquivo substituiu tambem o antigo `.env.local.example`, que listava
# nomes que o codigo nao le mais (NEXT_PUBLIC_GTM_ID, NEXT_PUBLIC_META_PIXEL_ID,
# NEXT_PUBLIC_IG, NEXT_PUBLIC_EMAIL, NEXT_PUBLIC_PUPPIES_BUCKET e outros).
# Preencher aqueles nomes nao tinha efeito nenhum.

# =============================================================================
# SUPABASE
# =============================================================================
# URL e chave anon do projeto (Settings > API). A anon respeita RLS e pode ir
# para o cliente.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service_role: IGNORA RLS. So no servidor, nunca com prefixo publico,
# nunca em log, nunca em teste apontando para o banco real.
SUPABASE_SERVICE_ROLE_KEY=

# Aliases sem prefixo, lidos por alguns scripts de manutencao. Opcionais: se
# vazios, valem os NEXT_PUBLIC_ acima.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Bucket do Storage com as fotos dos filhotes.
NEXT_PUBLIC_SUPABASE_BUCKET=

# =============================================================================
# AUTENTICACAO ADMINISTRATIVA
# =============================================================================
# Segredo que assina (HMAC-SHA256) o cookie de sessao do painel. SEM ele o
# painel nao autentica ninguem — a verificacao falha fechada de proposito.
# Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trocar este valor invalida todas as sessoes abertas.
ADMIN_SESSION_SECRET=

# Segredo de maquina, enviado no header `x-admin-pass`. Serve para chamada
# automatizada (curl, script de manutencao) que nao tem cookie de sessao.
# Minimo de 24 caracteres — abaixo disso o servidor recusa. Se voce nao precisa
# de chamada automatizada, deixe vazio.
ADMIN_PASS=

# Segredo das rotas internas (/api/search/reindex, /api/qa/embed-missing,
# /api/gamification/seed-badges), enviado no header `x-internal-token`. Minimo
# de 24 caracteres. Vazio = so sessao de admin abre essas rotas.
# Ate agosto de 2026 esse valor era uma frase escrita dentro do codigo, visivel
# para qualquer um que lesse o repositorio. Agora e chave de verdade e rotativa.
INTERNAL_API_SECRET=

# Identidade padrao usada pelas rotas de integracao e de tracking quando nao ha
# sessao (UUID do usuario dono das integracoes).
ADMIN_USER_ID=
DEFAULT_ADMIN_USER_ID=
INTEGRATIONS_DEFAULT_USER_ID=

# E-mail que recebe copia de contrato e de aviso operacional.
ADMIN_EMAIL=

# =============================================================================
# TAREFAS AGENDADAS (CRON)
# =============================================================================
# Protege /api/cron/* e /api/blog/publish-due. Chega como
# `Authorization: Bearer <segredo>` ou `x-cron-secret`. Minimo de 24 caracteres.
#
# SEM esta variavel os endpoints agendados FICAM BLOQUEADOS (503). Ate agosto de
# 2026 era o contrario: sem chave eles respondiam a qualquer chamada, e quem
# descobrisse a URL publicava post e disparava venda. Falta de chave passou a
# ser falha de configuracao, e falha de configuracao fecha a porta.
# Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# =============================================================================
# APLICACAO
# =============================================================================
# Host publico do site, com protocolo e sem barra no fim. Define canonical,
# sitemap e redirecionamento de dominio.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_CANONICAL_ORIGIN=
SITE_ORIGIN=

# Ambiente logico (development | staging | production). Nao substitui NODE_ENV.
APP_ENV=
NEXT_PUBLIC_APP_ENV=

# Nivel de log do servidor (error | warn | info | debug).
LOG_LEVEL=

# Origem do conteudo editorial (contentlayer | supabase).
CMS_DRIVER=

# =============================================================================
# CONTATO E REDES (valores publicos, aparecem no site)
# =============================================================================
NEXT_PUBLIC_WA_PHONE=
NEXT_PUBLIC_WA_LINK=
NEXT_PUBLIC_WA_DISPLAY=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# =============================================================================
# MEDICAO E PIXELS (server-side)
# =============================================================================
# Nenhum destes leva NEXT_PUBLIC_: a configuracao e resolvida no servidor e o
# painel administrativo pode sobrescrever cada um deles no banco. O valor de
# ambiente e so o padrao de quem ainda nao configurou pelo painel.
#
# Com GTM_ID preenchido, o GTM e o unico orquestrador: GA4, Google Ads, Meta e
# TikTok devem ser configurados dentro do container, nao aqui, para nao carregar
# o mesmo provedor duas vezes.
GTM_ID=
GA4_ID=
GOOGLE_ADS_ID=
FACEBOOK_PIXEL_ID=
TIKTOK_PIXEL_ID=
PINTEREST_ID=
HOTJAR_ID=
CLARITY_ID=

# Meta-tags de verificacao de propriedade do dominio.
META_VERIFY=
GOOGLE_VERIFY=

# Chaves de corte da medicao. `1` desliga.
DISABLE_ANALYTICS=
NEXT_PUBLIC_DISABLE_ANALYTICS=
# `1` liga a medicao tambem fora de producao, para conferencia local.
NEXT_PUBLIC_FORCE_ANALYTICS=
# `1` grava evento tambem na fila de reenvio.
ANALYTICS_OUTBOX=

# =============================================================================
# IA (todas server-side)
# =============================================================================
OPENAI_API_KEY=
# Opcionais: apontam para outro endpoint ou fixam o modelo.
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_LEAD_MODEL=
OPENAI_VISION_MODEL=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_KEY=

# =============================================================================
# WHATSAPP (Meta Cloud API)
# =============================================================================
# developers.facebook.com > seu app > WhatsApp > Configuracao.
# WA_VERIFY_TOKEN: voce escolhe o valor e repete no painel da Meta. Nao deixe
# um valor padrao em producao.
WA_VERIFY_TOKEN=
# WA_APP_SECRET: App Secret do app Meta. E com ele que a rota confere a
# assinatura X-Hub-Signature-256 de cada POST. Sem esse valor o webhook
# responde 503 e nao processa nada — falha fechada, de proposito.
WA_APP_SECRET=
# Token permanente do System User.
WA_ACCESS_TOKEN=
# ID do numero (nao e o numero de telefone).
WA_PHONE_NUMBER_ID=

# =============================================================================
# INTEGRACOES OAUTH
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_SEARCH_CONSOLE_SITE_URL=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_AUTH_URL=
# INTEGRATIONS_ENCRYPTION_KEY: 32 bytes em hexadecimal (64 caracteres) ou em
# base64 (44 caracteres). E com ela que os tokens de OAuth sao cifrados antes
# de ir para a tabela `integrations` (AES-256-GCM). Sem essa variavel o
# callback recusa a conexao em vez de gravar token em texto puro.
# Para gerar um valor novo, localmente:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocar o valor torna ilegiveis os tokens ja gravados: e preciso reconectar
# cada provedor no painel.
INTEGRATIONS_ENCRYPTION_KEY=

# =============================================================================
# E-MAIL TRANSACIONAL
# =============================================================================
RESEND_API_KEY=
# Remetente verificado no dominio, no formato "Nome <endereco@dominio>".
RESEND_FROM=

# =============================================================================
# ASSINATURA DE CONTRATO (ZapSign)
# =============================================================================
ZAPSIGN_API_TOKEN=
# Segredo que valida a assinatura do webhook de retorno.
ZAPSIGN_WEBHOOK_SECRET=

# =============================================================================
# FERRAMENTAS DE DESENVOLVIMENTO E CI
# =============================================================================
# Chave da PageSpeed Insights API, usada pelos scripts de medicao.
PSI_API_KEY=
# Intervalo do worker de pos-venda, em milissegundos.
AUTOSALES_WORKER_INTERVAL_MS=
# `1` faz o teste de contraste percorrer o site inteiro em vez da amostra.
FULL_A11Y=
# Diretorio de build alternativo. No Windows com OneDrive, `.next-build` evita
# o bloqueio de arquivo em `.next/trace`.
NEXT_DIST_DIR=
