# Example environment variables for local development and CI.
# Copy this file to `.env.local` and fill with your real secrets.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
ADMIN_PASS=your_admin_password_here
# Segredo para assinar (HMAC-SHA256) o cookie de sessao admin. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_SESSION_SECRET=generate_a_random_32_byte_base64_secret_here

# Application
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_WA_PHONE=5511999999999
NEXT_PUBLIC_WA_LINK=https://wa.me/5511999999999

# OpenAI (server-only key)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# WhatsApp Agent (Meta Cloud API)
# Obtenha em: developers.facebook.com > seu app > WhatsApp > Configuração
#
# WA_VERIFY_TOKEN e WA_APP_SECRET sao OBRIGATORIOS. Sem eles o webhook
# responde 403 de proposito: o POST executa o agente de IA e envia WhatsApp
# pela conta do canil, entao ficar aberto seria pior que ficar fora do ar.
WA_VERIFY_TOKEN=defina_um_valor_aleatorio    # token livre que você define no painel Meta
# App Secret do app Meta (Configuracoes > Basico). Confere a assinatura
# X-Hub-Signature-256 de cada POST do webhook.
WA_APP_SECRET=your_meta_app_secret
WA_ACCESS_TOKEN=your_meta_system_user_token  # token permanente do System User
WA_PHONE_NUMBER_ID=your_phone_number_id      # ID do número (não o número em si)

# Deploy: o site e publicado pela Netlify, que le as variaveis do painel dela
# (Site configuration > Environment variables). Nao existe variavel de deploy
# aqui.

# Contatos oficiais (replace with your business info)
NEXT_PUBLIC_PHONE=+55 11 99999-9999
NEXT_PUBLIC_WA_LINK=https://wa.me/5511999999999
NEXT_PUBLIC_EMAIL=contato@example.com
NEXT_PUBLIC_CNPJ=00.000.000/0001-00
NEXT_PUBLIC_PUPPIES_BUCKET=puppies

# Redes sociais (replace with your handles)
NEXT_PUBLIC_IG=https://instagram.com/your_handle
NEXT_PUBLIC_YT=https://youtube.com/@your_handle
# Se usar TikTok ou Telegram, escolha um:
# NEXT_PUBLIC_TT=https://www.tiktok.com/@your_handle
# NEXT_PUBLIC_TG=https://t.me/your_channel

NEXT_PUBLIC_SITE_URL=https://www.example.com

# GTM/GA4 (replace with your tracking IDs)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX   # use se NÃO for usar GTM

# Pixels (replace with your pixel IDs)
NEXT_PUBLIC_META_PIXEL_ID=123456789012345
NEXT_PUBLIC_TIKTOK_PIXEL_ID=ABCDEFGHIJKL
NEXT_PUBLIC_PINTEREST_TAG_ID=2612345678901

# Opções (replace with your IDs)
NEXT_PUBLIC_HOTJAR_ID=xxxxx
NEXT_PUBLIC_HOTJAR_SV=6
NEXT_PUBLIC_CLARITY_ID=abcd1234

# Cron (funcao agendada da Netlify: netlify/functions/cron-due.mjs)
# Protege /api/cron/* e /api/blog/publish-due. Enquanto estiver vazia, esses
# endpoints respondem sem autenticacao. Gere um valor com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Rotas internas de manutencao (/api/search/reindex, /api/qa/embed-missing,
# /api/gamification/seed-badges). Enviado no header x-internal-token. Precisa
# de pelo menos 24 caracteres; enquanto estiver vazia, essas rotas respondem
# 401. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_TOKEN=

# Token das rotas de conteudo fora de /api/admin (/api/blog/generate,
# /api/blog/import, GET /api/analytics). Enviado no header x-admin-token.
# Enquanto estiver vazio essas rotas respondem 401.
ADMIN_TOKEN=

# Groq (chat do matchmaker e transcricao de audio). Chave de servidor.
GROQ_API_KEY=

# Curtidas de midia: sal do hash que identifica o visitante sem gravar IP.
# Sem ele /api/media-likes/toggle responde 503.
MEDIA_LIKE_SECRET=
