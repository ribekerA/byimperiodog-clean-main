{
  "name": "by-imperio-dog",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "scripts": {
    "predev": "node scripts/run-gen-client-photos.mjs && node scripts/gen-contentlayer.mjs && node scripts/gen-image-sizes.mjs",
    "prebuild": "tsx scripts/catalog-audit.mts && tsx scripts/showcase-audit.mts && node scripts/content-guard.mjs && node scripts/quality-gate.mjs --strict && node scripts/run-gen-client-photos.mjs && node scripts/gen-contentlayer.mjs && node scripts/gen-image-sizes.mjs && node scripts/gen-lastmod.mjs",
    "gen:lastmod": "node scripts/gen-lastmod.mjs",
    "gate": "node scripts/quality-gate.mjs",
    "gate:strict": "node scripts/quality-gate.mjs --strict-novos",
    "blog:export": "node scripts/export-post-to-mdx.mjs",
    "dev": "cross-env NEXT_DISABLE_VERSION_CHECK=1 NEXT_TELEMETRY_DISABLED=1 next dev -p 3000",
    "dev:https": "node scripts/run-gen-client-photos.mjs && cross-env NEXT_DISABLE_VERSION_CHECK=1 NEXT_TELEMETRY_DISABLED=1 node server-https.mjs",
    "build": "next build",
    "build:analyze": "next experimental-analyze",
    "build:stats": "npm run build && node scripts/collect-build-stats.mjs",
    "lh:serve": "next start -p 3000",
    "lh:run": "npx --yes lighthouse@12.8.2 http://localhost:3000/ --config-path=lighthouserc.json --output=json --output-path=./reports/lh-home.json",
    "lh:ci": "npm run build && npx lhci autorun",
    "start": "next start -p 3000",
    "lint": "cross-env NODE_OPTIONS=--max-old-space-size=8192 eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--max-old-space-size=8192 eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed-demo.ts",
    "embeddings:index": "tsx scripts/embeddings-index.ts",
    "seo:audit": "tsx scripts/seo-audit.ts",
    "seo:audit:prod": "cross-env SEO_AUDIT_URL=https://byimperiodog.com.br tsx scripts/seo-audit.ts",
    "production:seo-watch": "tsx scripts/seo-watch.ts",
    "cache:verify": "node scripts/verify-cache-headers.mjs",
    "build:search-index": "tsx scripts/build-search-index.ts",
    "fix:encoding:dry": "node scripts/fix-encoding.mjs --dry",
    "fix:encoding": "node scripts/fix-encoding.mjs --write",
    "db:fix-mojibake": "tsx scripts/fix-mojibake.ts",
    "db:fix-mojibake:write": "tsx scripts/fix-mojibake.ts --write",
    "a11y:contrast": "node scripts/a11y-contrast.mjs",
    "check:banned-words": "node scripts/check-banned-words.mjs",
    "test": "vitest --run",
    "test:unit": "vitest --run",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "check:all": "npm run typecheck && npm run test && npm run check:encoding && npm run check:banned-words && npm run catalog:audit && npm run showcase:audit && npm run lint",
    "check:encoding": "node scripts/check-encoding.mjs",
    "psi:validate": "node scripts/psi-validation.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:db:reset": "supabase db reset",
    "supabase:db:push": "supabase db push",
    "supabase:types": "supabase gen types typescript --local > src/types/supabase.ts",
    "images:process": "tsx scripts/image-pipeline/cli.ts",
    "images:analyze": "tsx scripts/image-pipeline/quality-analyzer.ts",
    "images:clean": "node -e \"require('fs').rmSync('public/puppies', {recursive: true, force: true})\"",
    "autosales:worker": "tsx scripts/auto-sales-worker.ts",
    "autosales:worker:loop": "tsx scripts/auto-sales-worker.ts --loop",
    "route:validate": "tsx scripts/route-validator.ts",
    "route:validate:prod": "ROUTE_VALIDATOR_URL=https://byimperiodog.com.br tsx scripts/route-validator.ts",
    "postinstall": "echo \"Ready.\"",
    "vercel-build": "npm run build",
    "gen:video-posters": "tsx scripts/gen-video-posters.mts",
    "catalog:audit": "tsx scripts/catalog-audit.mts",
    "showcase:audit": "tsx scripts/showcase-audit.mts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-tooltip": "1.2.16",
    "@sanity/client": "^6.15.10",
    "@supabase/supabase-js": "2.112.3",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/react-table": "^8.10.8",
    "@tanstack/react-virtual": "^3.10.6",
    "@tiptap/extension-image": "^3.8.0",
    "@tiptap/extension-link": "^3.8.0",
    "@tiptap/extension-placeholder": "^3.8.0",
    "@tiptap/extension-typography": "^3.8.0",
    "@tiptap/react": "^3.8.0",
    "@tiptap/starter-kit": "^3.8.0",
    "autoprefixer": "^10.4.20",
    "canvas-confetti": "^1.9.3",
    "class-variance-authority": "^0.7.0",
    "classnames": "^2.5.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.12",
    "googleapis": "^173.0.0",
    "groq": "^3.45.0",
    "lucide-react": "^0.540.0",
    "next": "16.3.3",
    "next-mdx-remote": "6.0.0",
    "novel": "^1.0.2",
    "openai": "^5.23.2",
    "pdf-lib": "^1.17.1",
    "postcss": "8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-dropzone": "^14.2.3",
    "react-easy-crop": "^5.2.0",
    "react-hook-form": "7.86.0",
    "react-tsparticles": "^2.12.2",
    "recharts": "^3.1.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.12.6",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "0.35.3",
    "shiki": "^1.22.0",
    "tailwindcss": "3.4.19",
    "tsparticles-slim": "^2.12.0",
    "typescript": "5.9.3",
    "web-vitals": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "4.13.0",
    "cross-env": "^10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-refresh": "^0.4.6",
    "happy-dom": "^20.11.8",
    "jsdom": "^27.0.0",
    "node-fetch": "^2.7.0",
    "playwright": "1.62.1",
    "shikiji": "^0.10.2",
    "supabase": "2.115.0",
    "tsx": "4.23.12",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
