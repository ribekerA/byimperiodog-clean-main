{
  "name": "by-imperio-dog",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "scripts": {
    "predev": "node scripts/run-gen-client-photos.mjs && node scripts/gen-contentlayer.mjs && node scripts/gen-image-sizes.mjs",
    "prebuild": "tsx scripts/catalog-audit.mts && tsx scripts/showcase-audit.mts && tsx scripts/keyword-audit.mts && node scripts/content-guard.mjs && tsx scripts/public-truth-guard.mts && node scripts/quality-gate.mjs --strict && node scripts/run-gen-client-photos.mjs && node scripts/gen-contentlayer.mjs && node scripts/gen-image-sizes.mjs && node scripts/gen-lastmod.mjs",
    "gen:lastmod": "node scripts/gen-lastmod.mjs",
    "gate": "node scripts/quality-gate.mjs",
    "gate:strict": "node scripts/quality-gate.mjs --strict-novos",
    "blog:export": "node scripts/export-post-to-mdx.mjs",
    "dev": "cross-env NEXT_DISABLE_VERSION_CHECK=1 NEXT_TELEMETRY_DISABLED=1 next dev -p 3000",
    "dev:https": "node scripts/run-gen-client-photos.mjs && cross-env NEXT_DISABLE_VERSION_CHECK=1 NEXT_TELEMETRY_DISABLED=1 node server-https.mjs",
    "build": "next build",
    "build:analyze": "next experimental-analyze",
    "build:stats": "npm run build && node scripts/collect-build-stats.mjs",
    "lh:serve": "next start -p 3000",
    "lh:run": "npx --yes lighthouse@12.8.2 http://localhost:3000/ --only-categories=performance,accessibility,best-practices,seo --form-factor=mobile --output=json --output-path=./reports/lh-home.json --quiet",
    "lh:ci": "npm run build && npx lhci autorun",
    "start": "next start -p 3000",
    "lint": "cross-env NODE_OPTIONS=--max-old-space-size=8192 eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--max-old-space-size=8192 eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed-demo.ts",
    "embeddings:index": "tsx scripts/embeddings-index.ts",
    "seo:audit": "tsx scripts/seo-audit.ts",
    "seo:keywords": "tsx scripts/keyword-audit.mts",
    "seo:audit:prod": "cross-env SEO_AUDIT_URL=https://byimperiodog.com.br tsx scripts/seo-audit.ts",
    "production:seo-watch": "tsx scripts/seo-watch.ts",
    "cache:verify": "node scripts/verify-cache-headers.mjs",
    "build:search-index": "tsx scripts/build-search-index.ts",
    "fix:encoding:dry": "node scripts/fix-encoding.mjs --dry",
    "fix:encoding": "node scripts/fix-encoding.mjs --write",
    "db:fix-mojibake": "tsx scripts/fix-mojibake.ts",
    "db:fix-mojibake:write": "tsx scripts/fix-mojibake.ts --write",
    "a11y:contrast": "node scripts/a11y-contrast.mjs",
    "check:banned-words": "node scripts/check-banned-words.mjs",
    "test": "vitest --run",
    "test:unit": "vitest --run",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "check:all": "npm run typecheck && npm run test && npm run check:encoding && npm run check:banned-words && npm run catalog:audit && npm run showcase:audit && npm run truth:guard && npm run lint",
    "check:encoding": "node scripts/check-encoding.mjs",
    "psi:validate": "node scripts/psi-validation.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:db:reset": "supabase db reset",
    "supabase:db:push": "supabase db push",
    "supabase:types": "supabase gen types typescript --local > src/types/supabase.ts",
    "images:process": "tsx scripts/image-pipeline/cli.ts",
    "images:analyze": "tsx scripts/image-pipeline/quality-analyzer.ts",
    "images:clean": "node -e \"require('fs').rmSync('public/puppies', {recursive: true, force: true})\"",
    "autosales:worker": "tsx scripts/auto-sales-worker.ts",
    "autosales:worker:loop": "tsx scripts/auto-sales-worker.ts --loop",
    "route:validate": "tsx scripts/route-validator.ts",
    "route:validate:prod": "ROUTE_VALIDATOR_URL=https://byimperiodog.com.br tsx scripts/route-validator.ts",
    "postinstall": "echo \"Ready.\"",
    "vercel-build": "npm run build",
    "gen:video-posters": "tsx scripts/gen-video-posters.mts",
    "catalog:audit": "tsx scripts/catalog-audit.mts",
    "showcase:audit": "tsx scripts/showcase-audit.mts",
    "truth:guard": "tsx scripts/public-truth-guard.mts"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.8",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-tooltip": "1.4.1",
    "@sanity/client": "^8.17.0",
    "@supabase/supabase-js": "2.119.2",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.26",
    "@tiptap/extension-image": "3.35.0",
    "@tiptap/extension-link": "3.35.0",
    "@tiptap/extension-placeholder": "3.35.0",
    "@tiptap/extension-typography": "3.35.0",
    "@tiptap/react": "3.35.0",
    "@tiptap/starter-kit": "3.35.0",
    "autoprefixer": "^10.7.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.43.0",
    "googleapis": "^190.0.0",
    "groq": "^6.24.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "next-mdx-remote": "6.0.0",
    "openai": "^7.62.0",
    "pdf-lib": "^1.17.1",
    "postcss": "8.5.33",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-dropzone": "^20.2.1",
    "react-easy-crop": "^6.2.5",
    "react-hook-form": "7.92.0",
    "react-tsparticles": "^2.12.2",
    "recharts": "^3.11.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.6",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "shiki": "^4.6.0",
    "tailwindcss": "3.4.19",
    "tsparticles-slim": "^2.12.0",
    "web-vitals": "^5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "@vitest/coverage-v8": "^5.1.1",
    "axe-core": "4.14.1",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-refresh": "^0.5.8",
    "happy-dom": "21.0.4",
    "jsdom": "^27.4.0",
    "node-fetch": "^2.7.0",
    "playwright": "1.65.1",
    "shikiji": "^0.10.2",
    "supabase": "2.122.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "postcss-selector-parser": "^6.1.6"
  }
}
